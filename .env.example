# Servidor
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soil_analysis
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Autenticação
JWT_SECRET=gere-um-segredo-aleatorio-com-pelo-menos-32-caracteres
COOKIE_SECURE=false
INVITE_CODE=defina-um-codigo-de-convite-forte

# Administrador inicial (opcional; criado automaticamente se informado)
ADMIN_NAME=Administrador
ADMIN_EMAIL=
ADMIN_PASSWORD=

# E-mail SMTP (necessário para recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Soil Analysis <nao-responda@example.com>
